*.dll binary
*.exe binary
*.zip binary
*.png binary
*.json text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.patch whitespace=-trailing-space,-space-before-tab
# Source snapshots retain the original emulator's formatting.
store/*/*/cores/*/source/integration/** whitespace=-trailing-space,-space-before-tab

# Preserve upstream snapshots byte for byte when changing target paths.
store/*/*/cores/*/source/** -text
