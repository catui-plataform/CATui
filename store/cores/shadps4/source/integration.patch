+std::mutex transfer_callbacks_mutex;
+std::unordered_map<SceUsbdTransfer*, SceUsbdTransferCallback> transfer_callbacks;
+
+void LIBUSB_CALL HostTransferCallback(SceUsbdTransfer* transfer) {
+    SceUsbdTransferCallback callback{};
+    {
+        std::scoped_lock lock{transfer_callbacks_mutex};
+        if (const auto it = transfer_callbacks.find(transfer); it != transfer_callbacks.end()) {
+            callback = it->second;
+        }
+    }
+    if (callback != nullptr) {
+        callback(transfer);
+    }
+}
+
+libusb_transfer_cb_fn RegisterTransferCallback(SceUsbdTransfer* transfer,
+                                               SceUsbdTransferCallback callback) {
+    std::scoped_lock lock{transfer_callbacks_mutex};
+    if (callback == nullptr) {
+        transfer_callbacks.erase(transfer);
+        return nullptr;
+    }
+    transfer_callbacks.insert_or_assign(transfer, callback);
+    return HostTransferCallback;
+}
+
+void ForgetTransferCallback(SceUsbdTransfer* transfer) {
+    std::scoped_lock lock{transfer_callbacks_mutex};
+    transfer_callbacks.erase(transfer);
+}
