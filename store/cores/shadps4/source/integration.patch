new file mode 100644
index 00000000..76dbbae9
--- /dev/null
+++ b/src/libretro/catui_libretro_bridge.cpp
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "catui_libretro_bridge.h"
+
+#include <utility>
+
+namespace Catui::Libretro {
+
+Bridge::Bridge(Backend backend) : backend_(backend) {}
+
+Bridge::~Bridge() {
+    Unload();
+    if (backend_.destroy) {
+        backend_.destroy(backend_.user);
+        backend_.user = nullptr;
+    }
+}
+
+void Bridge::SetCallbacks(Callbacks callbacks) {
+    callbacks_ = callbacks;
+}
+
+void Bridge::SetVideoSettings(VideoSettings settings) {
+    // Settings are only consumed by the next load. This prevents changing
+    // Vulkan ownership or resolution while a frame callback is in flight.
+    settings_ = std::move(settings);
+}
+
+bool Bridge::Load(const std::filesystem::path& content) {
+    Unload();
+    if (backend_.load == nullptr) {
+        return false;
+    }
+    loaded_ = backend_.load(backend_.user, content, settings_, callbacks_);
+    return loaded_;
+}
+
+bool Bridge::RunFrame() {
+    return loaded_ && backend_.run_frame != nullptr && backend_.run_frame(backend_.user);
+}
+
+void Bridge::SetPaused(bool paused) {
+    if (loaded_ && backend_.set_paused) backend_.set_paused(backend_.user, paused);
+}
+
+void Bridge::Unload() {
+    if (loaded_ && backend_.unload != nullptr) {
+        backend_.unload(backend_.user);
+    }
+    loaded_ = false;
+}
+
+} // namespace Catui::Libretro
diff --git a/src/libretro/catui_libretro_bridge.h b/src/libretro/catui_libretro_bridge.h
new file mode 100644
index 00000000..163433a8
--- /dev/null
+++ b/src/libretro/catui_libretro_bridge.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// CATUI keeps the Libretro boundary in this small, dependency-free interface.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+namespace Catui::Libretro {
+
+enum class PixelFormat : std::uint32_t { XRGB8888, RGB565 };
+
+struct VideoFrame {
+    const void* data{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::size_t pitch{};
+    PixelFormat format{PixelFormat::XRGB8888};
+    std::uint64_t serial{};
+};
+
+struct InputState {
+    std::int16_t buttons[17]{};
+    std::int16_t axes[4]{};
+    std::int16_t touch_x{};
+    std::int16_t touch_y{};
+    bool touch_pressed{};
+    float gyro[3]{};
+};
+
+struct VideoSettings {
+    std::string renderer_backend{"vulkan"};
+    std::string resolution_scale{"1.0"};
+    std::string present_mode{"fifo"};
+    std::string readbacks_mode{"disabled"};
+    std::string windows_red_zone_protection{"static_patching"};
+    std::uint32_t window_width{1280};
+    std::uint32_t window_height{720};
+    std::uint32_t vblank_frequency{60};
+    std::int32_t gpu_id{-1};
+    std::int32_t rcas_attenuation{25};
+    bool neo_mode{false};
+    bool hdr_output{false};
+    bool fsr_enabled{false};
+    bool rcas_enabled{true};
+    bool pipeline_cache_archived{true};
+    bool pipeline_cache_enabled{true};
+    bool copy_gpu_buffers{false};
+    bool readback_linear_images_enabled{false};
+    bool direct_memory_access_enabled{false};
+    bool userfaultfd_tracking{false};
+    bool vk_crash_diagnostics{false};
+    bool rumble{true};
+    bool touch_motion{true};
+};
+
+struct Callbacks {
+    void* user{};
+    void (*video)(void* user, const VideoFrame& frame){};
+    void (*audio)(void* user, const std::int16_t* samples, std::size_t frames){};
+    InputState (*input)(void* user, std::uint32_t port){};
+    bool (*rumble)(void* user, std::uint32_t port, std::uint16_t strong,
+                   std::uint16_t weak){};
+    void (*log)(void* user, const char* message){};
+};
+
+// The emulator owns the implementation of these hooks. Keeping the hooks
+// outside the Libretro ABI makes upstream rebases local to this adapter.
+struct Backend {
+    void* user{};
+    bool (*load)(void* user, const std::filesystem::path& content,
+                const VideoSettings& settings, const Callbacks& callbacks){};
+    bool (*run_frame)(void* user){};
+    void (*unload)(void* user){};
+    void (*destroy)(void* user){};
+    void (*set_paused)(void* user, bool paused){};
+};
+
+class Bridge final {
+public:
+    explicit Bridge(Backend backend);
+    ~Bridge();
+
+    Bridge(const Bridge&) = delete;
+    Bridge& operator=(const Bridge&) = delete;
+
+    void SetCallbacks(Callbacks callbacks);
+    void SetVideoSettings(VideoSettings settings);
+    bool Load(const std::filesystem::path& content);
+    bool RunFrame();
+    void SetPaused(bool paused);
+    void Unload();
+    bool IsLoaded() const { return loaded_; }
+
+private:
+    Backend backend_{};
+    Callbacks callbacks_{};
+    VideoSettings settings_{};
+    bool loaded_{};
+};
+
+} // namespace Catui::Libretro
diff --git a/src/libretro/catui_libretro_smoke.cpp b/src/libretro/catui_libretro_smoke.cpp
new file mode 100644
index 00000000..e69fedce
--- /dev/null
+++ b/src/libretro/catui_libretro_smoke.cpp
@@ -0,0 +1,139 @@
+// Small ABI/lifecycle smoke test. It does not emulate a PS4 title.
+#include "catui_libretro_api.h"
+
+#include <algorithm>
+#include <cstring>
+#include <cstdlib>
+#include <fstream>
+#include <string_view>
+#include <vector>
+
+namespace {
+Catui::Libretro::Callbacks g_callbacks{};
+std::vector<std::uint32_t> g_frame;
+unsigned g_frame_count{};
+std::uint32_t g_first_pixel{};
+Catui::Libretro::VideoSettings g_settings{};
+bool g_variables_registered{};
+bool g_xrgb8888_negotiated{};
+bool g_analog_polled{};
+bool g_touch_polled{};
+bool g_rumble_strong{};
+bool g_rumble_weak{};
+bool g_backend_paused{};
+
+bool load(void*, const std::filesystem::path&, const Catui::Libretro::VideoSettings& settings,
+          const Catui::Libretro::Callbacks& callbacks) {
+    g_callbacks = callbacks;
+    g_settings = settings;
+    return true;
+}
+bool run(void*) {
+    if (g_callbacks.input) (void)g_callbacks.input(g_callbacks.user, 0);
+    if (g_callbacks.rumble) (void)g_callbacks.rumble(g_callbacks.user, 0, 0x8080, 0x4040);
+    if (g_callbacks.video) {
+        static std::uint32_t pixels[1600 * 900];
+        const std::uint32_t color = g_frame_count == 0 ? 0xff203040u : 0xffc08020u;
+        std::fill(std::begin(pixels), std::end(pixels), color);
+        Catui::Libretro::VideoFrame frame{pixels, 1600, 900, 1600 * sizeof(std::uint32_t),
+                                          Catui::Libretro::PixelFormat::XRGB8888, g_frame_count};
+        g_callbacks.video(g_callbacks.user, frame);
+    }
+    return true;
+}
+void unload(void*) {}
+void set_paused(void*, bool paused) { g_backend_paused = paused; }
+Catui::Libretro::Backend backend() {
+    return {nullptr, load, run, unload, nullptr, set_paused};
+}
+
+void video(const void* data, unsigned width, unsigned height, std::size_t pitch) {
+    g_frame.resize(width * height);
+    for (unsigned row = 0; row < height; ++row) {
+        std::memcpy(g_frame.data() + row * width,
+                    static_cast<const std::byte*>(data) + row * pitch,
+                    width * sizeof(std::uint32_t));
+    }
+    if (g_frame_count == 0) g_first_pixel = g_frame.front();
+    ++g_frame_count;
+}
+
+bool environment(unsigned command, void* data) {
+    if (command == RETRO_ENVIRONMENT_SET_VARIABLES) {
+        g_variables_registered = data != nullptr;
+        return true;
+    }
+    if (command == RETRO_ENVIRONMENT_SET_PIXEL_FORMAT) {
+        g_xrgb8888_negotiated =
+            data && *static_cast<retro_pixel_format*>(data) == RETRO_PIXEL_FORMAT_XRGB8888;
+        return g_xrgb8888_negotiated;
+    }
+    if (command == RETRO_ENVIRONMENT_GET_RUMBLE_INTERFACE) {
+        if (!data) return false;
+        auto* rumble = static_cast<retro_rumble_interface*>(data);
+        rumble->set_rumble_state = [](unsigned port, retro_rumble_effect effect,
+                                      std::uint16_t strength) {
+            if (port != 0) return false;
+            if (effect == RETRO_RUMBLE_STRONG && strength == 0x8080) g_rumble_strong = true;
+            if (effect == RETRO_RUMBLE_WEAK && strength == 0x4040) g_rumble_weak = true;
+            return true;
+        };
+        return true;
+    }
+    if (command != RETRO_ENVIRONMENT_GET_VARIABLE || !data) return false;
+
+    auto* variable = static_cast<retro_variable*>(data);
+    const std::string_view key{variable->key ? variable->key : ""};
+    if (key == "shadps4_renderer_backend") variable->value = "vulkan";
+    else if (key == "shadps4_window_width") variable->value = "1600";
+    else if (key == "shadps4_window_height") variable->value = "900";
+    else if (key == "shadps4_resolution_scale") variable->value = "1.5";
+    else if (key == "shadps4_neo_mode") variable->value = "enabled";
+    else if (key == "shadps4_windows_red_zone_protection") variable->value = "static_patching";
+    else variable->value = nullptr;
+    return variable->value != nullptr;
+}
+
+std::int16_t input(unsigned, unsigned device, unsigned, unsigned) {
+    if (device == RETRO_DEVICE_ANALOG) g_analog_polled = true;
+    if (device == RETRO_DEVICE_POINTER) g_touch_polled = true;
+    return 0;
+}
+} // namespace
+
+int main() {
+    catui_libretro_bind_backend(backend);
+    retro_set_environment(environment);
+    retro_set_video_refresh(video);
+    retro_set_input_state(input);
+    retro_init();
+    retro_game_info game{"smoke.elf", nullptr, 0, nullptr};
+    if (!retro_load_game(&game)) return 2;
+    retro_run();
+    retro_set_paused(true);
+    if (!retro_get_paused() || !g_backend_paused) return 9;
+    retro_run();
+    if (g_frame_count != 1) return 10;
+    retro_set_paused(false);
+    if (retro_get_paused() || g_backend_paused) return 11;
+    retro_run();
+    retro_unload_game();
+    if (!g_variables_registered || !g_xrgb8888_negotiated) return 3;
+    if (g_settings.renderer_backend != "vulkan" || g_settings.window_width != 1600 ||
+        g_settings.window_height != 900 || g_settings.resolution_scale != "1.5" ||
+        !g_settings.neo_mode || g_settings.windows_red_zone_protection != "static_patching") return 4;
+    if (!g_analog_polled || !g_touch_polled) return 5;
+    if (!g_rumble_strong || !g_rumble_weak) return 8;
+    if (g_frame_count != 2 || g_frame.size() != 1600 * 900 ||
+        g_frame.front() == g_first_pixel) return 6;
+
+    const char* output = std::getenv("CATUI_SMOKE_OUTPUT");
+    std::ofstream out(output ? output : "catui-libretro-smoke.ppm", std::ios::binary);
+    out << "P6\n1600 900\n255\n";
+    for (std::uint32_t pixel : g_frame) {
+        out.put(static_cast<char>((pixel >> 16) & 0xff));
+        out.put(static_cast<char>((pixel >> 8) & 0xff));
+        out.put(static_cast<char>(pixel & 0xff));
+    }
+    return out.good() ? 0 : 7;
+}
diff --git a/src/libretro/catui_ps4_host.cpp b/src/libretro/catui_ps4_host.cpp
new file mode 100644
index 00000000..13862ef3
--- /dev/null
+++ b/src/libretro/catui_ps4_host.cpp
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Disposable process for the real shadPS4 DLL. No standalone UI is created.
+#include "catui_libretro_api.h"
+#include "catui_ps4_ipc.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <thread>
+#include <mmsystem.h>
+
+namespace {
+using namespace Catui::Ps4Ipc;
+Shared* shared{};
+
+void Video(const void* data, unsigned width, unsigned height, std::size_t pitch) {
+    if (!shared || !data || !width || !height || width > MaxWidth || height > MaxHeight ||
+        pitch < width * 4 || pitch * height > MaxFrameBytes) return;
+    const LONG published = Read(&shared->published_slot);
+    const LONG slot = published == 0 ? 1 : 0;
+    if (Read(&shared->reading_slot) == slot) return;
+    std::memcpy(shared->pixels[slot], data, pitch * height);
+    shared->width[slot] = width;
+    shared->height[slot] = height;
+    shared->pitch[slot] = static_cast<unsigned>(pitch);
+    Write(&shared->published_slot, slot);
+    InterlockedIncrement(&shared->frame_serial);
+}
+
+std::size_t Audio(const std::int16_t* data, std::size_t frames) {
+    if (!shared || !data || !frames) return frames;
+    LONG write = Read(&shared->audio_write);
+    const LONG read = Read(&shared->audio_read);
+    const unsigned queued = static_cast<unsigned>(write - read);
+    const unsigned writable = queued < AudioFrames ? AudioFrames - queued : 0;
+    const unsigned count = static_cast<unsigned>(std::min(frames, static_cast<std::size_t>(writable)));
+    for (unsigned i = 0; i < count; ++i) {
+        const unsigned index = (static_cast<unsigned>(write) + i) % AudioFrames;
+        shared->audio[index * 2] = data[i * 2];
+        shared->audio[index * 2 + 1] = data[i * 2 + 1];
+    }
+    Write(&shared->audio_write, write + static_cast<LONG>(count));
+    return frames;
+}
+
+std::int16_t Input(unsigned port, unsigned device, unsigned index, unsigned id) {
+    if (!shared || port != 0) return 0;
+    if (device == RETRO_DEVICE_JOYPAD && id < 16)
+        return static_cast<std::int16_t>(Read(&shared->input_buttons[id]));
+    if (device == RETRO_DEVICE_ANALOG && index < 2 && id < 2)
+        return static_cast<std::int16_t>(Read(&shared->input_axes[index * 2 + id]));
+    if (device == RETRO_DEVICE_POINTER) {
+        if (id == RETRO_DEVICE_ID_POINTER_X) return static_cast<std::int16_t>(Read(&shared->touch_x));
+        if (id == RETRO_DEVICE_ID_POINTER_Y) return static_cast<std::int16_t>(Read(&shared->touch_y));
+        if (id == RETRO_DEVICE_ID_POINTER_PRESSED) return Read(&shared->touch_pressed) != 0;
+    }
+    return 0;
+}
+
+bool Rumble(unsigned, retro_rumble_effect effect, std::uint16_t strength) {
+    if (!shared) return false;
+    Write(effect == RETRO_RUMBLE_STRONG ? &shared->rumble_strong : &shared->rumble_weak,
+          strength);
+    return true;
+}
+
+bool Environment(unsigned command, void* data) {
+    if (command == RETRO_ENVIRONMENT_SET_VARIABLES || command == RETRO_ENVIRONMENT_SET_PIXEL_FORMAT)
+        return true;
+    if (command == RETRO_ENVIRONMENT_GET_RUMBLE_INTERFACE && data) {
+        static retro_rumble_interface rumble{Rumble};
+        *static_cast<retro_rumble_interface*>(data) = rumble;
+        return true;
+    }
+    if (command != RETRO_ENVIRONMENT_GET_VARIABLE || !data || !shared) return false;
+    auto* variable = static_cast<retro_variable*>(data);
+    if (!variable->key) return false;
+    for (unsigned i = 0; i < shared->option_count && i < MaxOptions; ++i) {
+        if (std::strcmp(variable->key, shared->options[i].key) == 0) {
+            variable->value = shared->options[i].value;
+            return true;
+        }
+    }
+    variable->value = nullptr;
+    return false;
+}
+
+void Poll() {}
+} // namespace
+
+int wmain(int argc, wchar_t** argv) {
+    if (argc != 4) return 2;
+    timeBeginPeriod(1);
+    if (!SetEnvironmentVariableW(L"CATUI_SHADPS4_HOME_DIR", argv[3])) return 2;
+    HANDLE mapping = OpenFileMappingW(FILE_MAP_ALL_ACCESS, FALSE, argv[1]);
+    if (!mapping) return 3;
+    shared = static_cast<Shared*>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(Shared)));
+    if (!shared || shared->version != Version) return 4;
+
+    retro_set_environment(Environment);
+    retro_set_video_refresh(Video);
+    retro_set_audio_sample_batch(Audio);
+    retro_set_input_state(Input);
+    retro_set_input_poll(Poll);
+    retro_init();
+    const std::string content = std::filesystem::path(argv[2]).string();
+    retro_game_info game{content.c_str(), nullptr, 0, nullptr};
+    if (!retro_load_game(&game)) {
+        Write(&shared->ready, -1);
+        TerminateProcess(GetCurrentProcess(), 5);
+    }
+    Write(&shared->ready, 1);
+
+    bool was_paused = false;
+    auto next_frame = std::chrono::steady_clock::now();
+    while (!Read(&shared->stop)) {
+        const bool paused = Read(&shared->paused) != 0;
+        if (paused != was_paused) {
+            retro_set_paused(paused);
+            was_paused = paused;
+        }
+        if (!paused) retro_run();
+        next_frame += std::chrono::microseconds(16667);
+        const auto now = std::chrono::steady_clock::now();
+        if (next_frame < now) next_frame = now;
+        std::this_thread::sleep_until(next_frame);
+    }
+    retro_set_paused(false);
+    retro_unload_game();
+    retro_deinit();
+    Write(&shared->ready, 0);
+    // Upstream process-lifetime singletons must not be re-entered at DLL detach.
+    TerminateProcess(GetCurrentProcess(), 0);
+}
diff --git a/src/libretro/catui_ps4_ipc.h b/src/libretro/catui_ps4_ipc.h
new file mode 100644
index 00000000..640bf8dc
--- /dev/null
+++ b/src/libretro/catui_ps4_ipc.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstdint>
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace Catui::Ps4Ipc {
+
+constexpr unsigned Version = 1;
+constexpr unsigned MaxWidth = 3840;
+constexpr unsigned MaxHeight = 2160;
+constexpr unsigned MaxFrameBytes = MaxWidth * MaxHeight * 4;
+constexpr unsigned AudioFrames = 48000;
+constexpr unsigned MaxOptions = 32;
+
+struct Option {
+    char key[64]{};
+    char value[128]{};
+};
+
+struct Shared {
+    unsigned version{Version};
+    volatile LONG ready{}; // 1: loaded; -1: load failed
+    volatile LONG stop{};
+    volatile LONG paused{};
+    volatile LONG published_slot{-1};
+    volatile LONG reading_slot{-1};
+    volatile LONG frame_serial{};
+    volatile LONG audio_write{};
+    volatile LONG audio_read{};
+    volatile LONG rumble_strong{};
+    volatile LONG rumble_weak{};
+    volatile LONG input_buttons[16]{};
+    volatile LONG input_axes[4]{};
+    volatile LONG touch_x{};
+    volatile LONG touch_y{};
+    volatile LONG touch_pressed{};
+    unsigned width[2]{};
+    unsigned height[2]{};
+    unsigned pitch[2]{};
+    unsigned option_count{};
+    Option options[MaxOptions]{};
+    std::int16_t audio[AudioFrames * 2]{};
+    std::uint8_t pixels[2][MaxFrameBytes]{};
+};
+
+inline LONG Read(volatile LONG* value) {
+    return InterlockedCompareExchange(value, 0, 0);
+}
+
+inline void Write(volatile LONG* value, LONG next) {
+    InterlockedExchange(value, next);
+}
+
+} // namespace Catui::Ps4Ipc
diff --git a/src/libretro/catui_ps4_proxy.cpp b/src/libretro/catui_ps4_proxy.cpp
new file mode 100644
index 00000000..5bf2d064
--- /dev/null
+++ b/src/libretro/catui_ps4_proxy.cpp
@@ -0,0 +1,330 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Lightweight Libretro boundary. Every PS4 title runs in a disposable host
+// because shadPS4's guest, Vulkan and HLE singletons are process-lifetime.
+#include "catui_libretro_api.h"
+#include "catui_ps4_ipc.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <new>
+#include <string>
+#include <vector>
+
+namespace {
+using namespace Catui::Ps4Ipc;
+
+retro_environment_t environment{};
+retro_video_refresh_t video{};
+retro_audio_sample_t audio_sample{};
+retro_audio_sample_batch_t audio_batch{};
+retro_input_poll_t input_poll{};
+retro_input_state_t input_state{};
+retro_rumble_interface rumble{};
+HANDLE mapping{};
+PROCESS_INFORMATION host{};
+Shared* shared{};
+LONG last_frame_serial{};
+std::vector<std::uint8_t> frame_copy{};
+std::vector<std::int16_t> audio_copy{};
+std::string last_error{};
+std::atomic<double> host_video_fps{};
+ULONGLONG fps_sample_tick{};
+LONG fps_sample_serial{};
+
+constexpr retro_variable variables[] = {
+    {"shadps4_renderer_backend", "Renderer; vulkan"},
+    {"shadps4_resolution_scale", "Internal Resolution; 1.0|1.5|2.0|3.0|4.0"},
+    {"shadps4_present_mode", "Present Mode; fifo|mailbox|immediate"},
+    {"shadps4_neo_mode", "PS4 Pro Mode; disabled|enabled"},
+    {"shadps4_hdr_output", "HDR Output; disabled|enabled"},
+    {"shadps4_window_width", "Output Width; 1280|1920|2560|3840"},
+    {"shadps4_window_height", "Output Height; 720|1080|1440|2160"},
+    {"shadps4_vblank_frequency", "VBlank Frequency; 60|30|120"},
+    {"shadps4_fsr_enabled", "AMD FSR; disabled|enabled"},
+    {"shadps4_rcas_enabled", "RCAS Sharpening; enabled|disabled"},
+    {"shadps4_rcas_attenuation", "RCAS Attenuation; 25|0|50|75|100"},
+    {"shadps4_pipeline_cache_enabled", "Vulkan Pipeline Cache; enabled|disabled"},
+    {"shadps4_pipeline_cache_archived", "Archived Pipeline Cache; enabled|disabled"},
+    {"shadps4_gpu_id", "Vulkan GPU Device; -1|0|1|2"},
+    {"shadps4_readbacks_mode", "GPU Readbacks; disabled|synchronous|asynchronous"},
+    {"shadps4_readback_linear_images_enabled", "Linear Readback Images; disabled|enabled"},
+    {"shadps4_direct_memory_access_enabled", "Direct Memory Access; disabled|enabled"},
+    {"shadps4_copy_gpu_buffers", "Copy GPU Buffers; disabled|enabled"},
+    {"shadps4_userfaultfd_tracking", "Userfaultfd Tracking; disabled|enabled"},
+    {"shadps4_vk_crash_diagnostics", "Vulkan Crash Diagnostics; disabled|enabled"},
+    {"shadps4_windows_red_zone_protection", "Windows Guest Red Zone; static_patching|disabled"},
+    {"shadps4_rumble", "DualShock Rumble; enabled|disabled"},
+    {"shadps4_touch_motion", "Touchpad and Motion; enabled|disabled"},
+    {nullptr, nullptr},
+};
+
+std::filesystem::path ModuleDirectory() {
+    HMODULE module{};
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCWSTR>(&retro_init), &module)) return {};
+    wchar_t path[32768]{};
+    const DWORD length = GetModuleFileNameW(module, path, 32768);
+    return length ? std::filesystem::path(path).parent_path() : std::filesystem::path{};
+}
+
+void CopyOptions() {
+    if (!environment || !shared) return;
+    for (const auto& descriptor : variables) {
+        if (!descriptor.key) break;
+        retro_variable variable{descriptor.key, nullptr};
+        if (!environment(RETRO_ENVIRONMENT_GET_VARIABLE, &variable) || !variable.value) continue;
+        if (shared->option_count >= MaxOptions) break;
+        auto& option = shared->options[shared->option_count++];
+        strncpy_s(option.key, descriptor.key, _TRUNCATE);
+        strncpy_s(option.value, variable.value, _TRUNCATE);
+    }
+}
+
+void CloseHost() {
+    if (shared) Write(&shared->stop, 1);
+    if (host.hProcess) {
+        // Only the host launched by this session can be terminated here.
+        if (WaitForSingleObject(host.hProcess, 10000) == WAIT_TIMEOUT) {
+            TerminateProcess(host.hProcess, 1);
+            WaitForSingleObject(host.hProcess, 2000);
+        }
+        CloseHandle(host.hProcess);
+        CloseHandle(host.hThread);
+        host = {};
+    }
+    if (shared) {
+        UnmapViewOfFile(shared);
+        shared = nullptr;
+    }
+    if (mapping) {
+        CloseHandle(mapping);
+        mapping = nullptr;
+    }
+    frame_copy.clear();
+    audio_copy.clear();
+    last_frame_serial = 0;
+    host_video_fps = 0.0;
+    fps_sample_tick = 0;
+    fps_sample_serial = 0;
+}
+
+void PollInput() {
+    if (!shared) return;
+    if (input_poll) input_poll();
+    if (!input_state) return;
+    for (unsigned button = 0; button < 16; ++button) {
+        Write(&shared->input_buttons[button], input_state(0, RETRO_DEVICE_JOYPAD, 0, button));
+    }
+    for (unsigned stick = 0; stick < 2; ++stick) {
+        for (unsigned axis = 0; axis < 2; ++axis) {
+            Write(&shared->input_axes[stick * 2 + axis],
+                  input_state(0, RETRO_DEVICE_ANALOG, stick, axis));
+        }
+    }
+    Write(&shared->touch_x, input_state(0, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_X));
+    Write(&shared->touch_y, input_state(0, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_Y));
+    Write(&shared->touch_pressed,
+          input_state(0, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_PRESSED));
+}
+
+void PollVideo() {
+    if (!shared || !video) return;
+    const LONG serial = Read(&shared->frame_serial);
+    if (serial == last_frame_serial) return;
+    const LONG slot = Read(&shared->published_slot);
+    if (slot < 0 || slot > 1) return;
+    Write(&shared->reading_slot, slot);
+    if (Read(&shared->published_slot) != slot) {
+        Write(&shared->reading_slot, -1);
+        return;
+    }
+    const unsigned width = shared->width[slot];
+    const unsigned height = shared->height[slot];
+    const unsigned pitch = shared->pitch[slot];
+    const std::size_t bytes = static_cast<std::size_t>(pitch) * height;
+    if (width && height && width <= MaxWidth && height <= MaxHeight &&
+        pitch >= width * 4 && bytes <= MaxFrameBytes) {
+        frame_copy.resize(bytes);
+        std::memcpy(frame_copy.data(), shared->pixels[slot], bytes);
+        last_frame_serial = serial;
+        Write(&shared->reading_slot, -1);
+        video(frame_copy.data(), width, height, pitch);
+    } else {
+        Write(&shared->reading_slot, -1);
+    }
+}
+
+void PollAudio() {
+    if (!shared || (!audio_batch && !audio_sample)) return;
+    LONG read = Read(&shared->audio_read);
+    const LONG write = Read(&shared->audio_write);
+    unsigned available = static_cast<unsigned>(write - read);
+    if (!available) return;
+    if (available > 4800u) {
+        const unsigned skip = available - 2048u;
+        read += static_cast<LONG>(skip);
+        Write(&shared->audio_read, read);
+        available = 2048u;
+    }
+    const unsigned frames = std::min(available, 4096u);
+    audio_copy.resize(frames * 2);
+    for (unsigned i = 0; i < frames; ++i) {
+        const unsigned index = (static_cast<unsigned>(read) + i) % AudioFrames;
+        audio_copy[i * 2] = shared->audio[index * 2];
+        audio_copy[i * 2 + 1] = shared->audio[index * 2 + 1];
+    }
+    std::size_t consumed = frames;
+    if (audio_batch) consumed = std::min(audio_batch(audio_copy.data(), frames),
+                                         static_cast<std::size_t>(frames));
+    else for (unsigned i = 0; i < frames; ++i)
+        audio_sample(audio_copy[i * 2], audio_copy[i * 2 + 1]);
+    Write(&shared->audio_read, read + static_cast<LONG>(consumed));
+}
+} // namespace
+
+extern "C" {
+void retro_set_environment(retro_environment_t callback) {
+    environment = callback;
+    if (environment) environment(RETRO_ENVIRONMENT_SET_VARIABLES,
+                                  const_cast<retro_variable*>(variables));
+}
+void retro_set_video_refresh(retro_video_refresh_t callback) { video = callback; }
+void retro_set_audio_sample(retro_audio_sample_t callback) { audio_sample = callback; }
+void retro_set_audio_sample_batch(retro_audio_sample_batch_t callback) { audio_batch = callback; }
+void retro_set_input_poll(retro_input_poll_t callback) { input_poll = callback; }
+void retro_set_input_state(retro_input_state_t callback) { input_state = callback; }
+unsigned retro_api_version() { return 1; }
+void retro_get_system_info(retro_system_info* info) {
+    if (info) *info = {"shadPS4 CATUI Proxy", "isolated-boundary",
+                       "elf|self|bin|zar", true, false};
+}
+void retro_get_system_av_info(retro_system_av_info* info) {
+    if (info) *info = {{1280, 720, MaxWidth, MaxHeight, 16.0f / 9.0f}, {60.0, 48000.0}};
+}
+void retro_init() {
+    if (environment) {
+        auto format = RETRO_PIXEL_FORMAT_XRGB8888;
+        environment(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format);
+    }
+}
+void retro_deinit() { retro_unload_game(); }
+bool retro_load_game(const retro_game_info* game) {
+    retro_unload_game();
+    last_error.clear();
+    if (!game || !game->path || !std::filesystem::exists(game->path)) {
+        last_error = "PS4 game executable is missing";
+        return false;
+    }
+    const auto host_path = ModuleDirectory() / L"catui_shadps4_host.exe";
+    if (!std::filesystem::exists(host_path)) {
+        last_error = "PS4 host executable is missing beside the core DLL";
+        return false;
+    }
+    const std::wstring map_name = L"Local\\CATuiPS4_" + std::to_wstring(GetCurrentProcessId()) +
+                                  L"_" + std::to_wstring(GetTickCount64());
+    mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0,
+                                 static_cast<DWORD>(sizeof(Shared)), map_name.c_str());
+    if (!mapping) {
+        last_error = "Could not create PS4 video/audio transport";
+        return false;
+    }
+    shared = static_cast<Shared*>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(Shared)));
+    if (!shared) {
+        last_error = "Could not map PS4 video/audio transport";
+        CloseHost();
+        return false;
+    }
+    new (shared) Shared{};
+    CopyOptions();
+    rumble = {};
+    if (environment) environment(RETRO_ENVIRONMENT_GET_RUMBLE_INTERFACE, &rumble);
+    const char* save_directory_utf8 = nullptr;
+    if (environment) environment(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &save_directory_utf8);
+    const std::filesystem::path save_directory =
+        save_directory_utf8 && *save_directory_utf8 ? std::filesystem::path(save_directory_utf8)
+                                                     : std::filesystem::path{};
+    std::wstring command = L"\"" + host_path.wstring() + L"\" \"" + map_name +
+                           L"\" \"" + std::filesystem::path(game->path).wstring() + L"\" \"" +
+                           save_directory.wstring() + L"\"";
+    STARTUPINFOW startup{};
+    startup.cb = sizeof(startup);
+    if (!CreateProcessW(host_path.c_str(), command.data(), nullptr, nullptr, FALSE,
+                        CREATE_NO_WINDOW, nullptr, host_path.parent_path().c_str(),
+                        &startup, &host)) {
+        last_error = "Could not start isolated PS4 host";
+        CloseHost();
+        return false;
+    }
+    const ULONGLONG deadline = GetTickCount64() + 45000;
+    while (GetTickCount64() < deadline) {
+        const LONG ready = Read(&shared->ready);
+        if (ready == 1) {
+            fps_sample_tick = GetTickCount64();
+            fps_sample_serial = Read(&shared->frame_serial);
+            return true;
+        }
+        if (ready < 0 || WaitForSingleObject(host.hProcess, 0) == WAIT_OBJECT_0) break;
+        Sleep(5);
+    }
+    DWORD exit_code = STILL_ACTIVE;
+    if (host.hProcess) GetExitCodeProcess(host.hProcess, &exit_code);
+    last_error = "PS4 host failed to load the game or timed out (exit=" +
+                 std::to_string(exit_code) + ")";
+    std::fprintf(stderr, "%s\\n", last_error.c_str());
+    CloseHost();
+    return false;
+}
+void retro_unload_game() { CloseHost(); }
+void retro_run() {
+    if (!shared) return;
+    if (WaitForSingleObject(host.hProcess, 0) == WAIT_OBJECT_0) {
+        host_video_fps = 0.0;
+        if (environment) environment(7, nullptr); // RETRO_ENVIRONMENT_SHUTDOWN
+        return;
+    }
+    const ULONGLONG now = GetTickCount64();
+    if (fps_sample_tick && now - fps_sample_tick >= 500) {
+        const LONG serial = Read(&shared->frame_serial);
+        const auto frames = static_cast<unsigned long>(serial) -
+                            static_cast<unsigned long>(fps_sample_serial);
+        host_video_fps = Read(&shared->paused) ? 0.0 :
+            static_cast<double>(frames) * 1000.0 / (now - fps_sample_tick);
+        fps_sample_serial = serial;
+        fps_sample_tick = now;
+    }
+    PollInput();
+    PollVideo();
+    PollAudio();
+    if (rumble.set_rumble_state) {
+        rumble.set_rumble_state(0, RETRO_RUMBLE_STRONG,
+                                static_cast<std::uint16_t>(Read(&shared->rumble_strong)));
+        rumble.set_rumble_state(0, RETRO_RUMBLE_WEAK,
+                                static_cast<std::uint16_t>(Read(&shared->rumble_weak)));
+    }
+}
+void retro_reset() {}
+void retro_set_paused(bool paused) {
+    if (!shared) return;
+    if (paused) {
+        Write(&shared->audio_read, Read(&shared->audio_write));
+    }
+    Write(&shared->paused, paused);
+}
+bool retro_get_paused() { return shared && Read(&shared->paused); }
+__declspec(dllexport) std::uint32_t retro_get_process_id() {
+    return host.hProcess && WaitForSingleObject(host.hProcess, 0) == WAIT_TIMEOUT
+        ? host.dwProcessId : 0;
+}
+// Count host video publications, including frames skipped by the frontend.
+__declspec(dllexport) double retro_get_game_fps() { return host_video_fps.load(); }
+std::size_t retro_serialize_size() { return 0; }
+bool retro_serialize(void*, std::size_t) { return false; }
+bool retro_unserialize(const void*, std::size_t) { return false; }
+void* retro_get_memory_data(unsigned) { return nullptr; }
+std::size_t retro_get_memory_size(unsigned) { return 0; }
+const char* retro_get_last_error() { return last_error.c_str(); }
+}
diff --git a/src/libretro/catui_real_probe.cpp b/src/libretro/catui_real_probe.cpp
new file mode 100644
index 00000000..88cd3ad7
--- /dev/null
+++ b/src/libretro/catui_real_probe.cpp
@@ -0,0 +1,175 @@
+#include "catui_libretro_api.h"
+
+#include <atomic>
+#include <cctype>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <mmsystem.h>
+#endif
+
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include <stb_image_write.h>
+
+namespace {
+std::filesystem::path first_output = "catui-real-first.png";
+std::filesystem::path last_output = "catui-real-last.png";
+std::atomic_uint total_frames{};
+std::atomic_uint visible_frames{};
+std::atomic_uint audio_frames{};
+std::atomic_uint64_t first_hash{};
+std::atomic_uint64_t last_hash{};
+std::atomic_bool capture_enabled{};
+std::mutex capture_mutex{};
+
+std::uint64_t Hash(const std::vector<std::uint8_t>& pixels) {
+    std::uint64_t value = 1469598103934665603ull;
+    for (const auto byte : pixels) {
+        value ^= byte;
+        value *= 1099511628211ull;
+    }
+    return value;
+}
+
+void Video(const void* data, unsigned width, unsigned height, std::size_t pitch) {
+    ++total_frames;
+    if (!capture_enabled.load(std::memory_order_acquire) || !data || !width || !height) return;
+
+    std::vector<std::uint8_t> rgb(static_cast<std::size_t>(width) * height * 3);
+    std::uint64_t intensity{};
+    for (unsigned y = 0; y < height; ++y) {
+        const auto* row = static_cast<const std::uint8_t*>(data) + y * pitch;
+        for (unsigned x = 0; x < width; ++x) {
+            const auto source = static_cast<std::size_t>(x) * 4;
+            const auto destination = (static_cast<std::size_t>(y) * width + x) * 3;
+            rgb[destination] = row[source + 2];
+            rgb[destination + 1] = row[source + 1];
+            rgb[destination + 2] = row[source];
+            intensity += rgb[destination] + rgb[destination + 1] + rgb[destination + 2];
+        }
+    }
+
+    // Ignore swapchain clears and nearly-black boot frames. A valid capture
+    // must average more than eight intensity steps per RGB channel.
+    if (intensity <= static_cast<std::uint64_t>(width) * height * 3 * 8) return;
+
+    const auto hash = Hash(rgb);
+    std::scoped_lock lock{capture_mutex};
+    if (visible_frames.load() == 0) {
+        first_hash.store(hash);
+        stbi_write_png(first_output.string().c_str(), static_cast<int>(width),
+                       static_cast<int>(height), 3, rgb.data(), static_cast<int>(width * 3));
+    }
+    last_hash.store(hash);
+    stbi_write_png(last_output.string().c_str(), static_cast<int>(width),
+                   static_cast<int>(height), 3, rgb.data(), static_cast<int>(width * 3));
+    ++visible_frames;
+}
+
+bool Environment(unsigned command, void* data) {
+    if (command == RETRO_ENVIRONMENT_SET_VARIABLES || command == RETRO_ENVIRONMENT_SET_PIXEL_FORMAT)
+        return true;
+    if (command != RETRO_ENVIRONMENT_GET_VARIABLE || !data) return false;
+    auto* variable = static_cast<retro_variable*>(data);
+    const std::string key = variable->key ? variable->key : "";
+    if (key == "shadps4_renderer_backend") variable->value = "vulkan";
+    else if (key == "shadps4_window_width") variable->value = "1280";
+    else if (key == "shadps4_window_height") variable->value = "720";
+    else if (key == "shadps4_windows_red_zone_protection") variable->value = "static_patching";
+    else variable->value = nullptr;
+    return variable->value != nullptr;
+}
+
+std::int16_t Input(unsigned, unsigned, unsigned, unsigned) { return 0; }
+void Poll() {}
+std::size_t Audio(const std::int16_t*, std::size_t count) {
+    audio_frames.fetch_add(static_cast<unsigned>(count), std::memory_order_relaxed);
+    return count;
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2) return 2;
+#ifdef _WIN32
+    timeBeginPeriod(1);
+#endif
+    const char* second_game = nullptr;
+    if (argc > 2) {
+        const std::filesystem::path candidate_output = argv[2];
+        auto ext = candidate_output.extension().string();
+        for (char& c : ext) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if (ext == ".png") {
+            first_output = candidate_output;
+            if (argc > 3) second_game = argv[3];
+        } else {
+            second_game = argv[2];
+        }
+    }
+    last_output = first_output.parent_path() /
+                  (first_output.stem().string() + ".last" + first_output.extension().string());
+
+    retro_set_environment(Environment);
+    retro_set_video_refresh(Video);
+    retro_set_input_state(Input);
+    retro_set_input_poll(Poll);
+    retro_set_audio_sample_batch(Audio);
+    int result = 0;
+    const int runs = second_game ? 2 : 1;
+    for (int run = 0; run < runs; ++run) {
+        total_frames = 0;
+        visible_frames = 0;
+        audio_frames = 0;
+        first_hash = 0;
+        last_hash = 0;
+        capture_enabled = false;
+        retro_init();
+        retro_game_info game{run == 0 ? argv[1] : second_game, nullptr, 0, nullptr};
+        if (!retro_load_game(&game)) {
+            result = 3;
+            break;
+        }
+
+        auto next_frame = std::chrono::steady_clock::now();
+        for (int i = 0; i < 1200; ++i) {
+            if (i == 500) capture_enabled.store(true, std::memory_order_release);
+            retro_run();
+            next_frame += std::chrono::microseconds(16667);
+            const auto now = std::chrono::steady_clock::now();
+            if (next_frame < now) next_frame = now;
+            std::this_thread::sleep_until(next_frame);
+            if (visible_frames.load() >= 2 && first_hash.load() != last_hash.load()) break;
+        }
+
+        retro_unload_game();
+        retro_deinit();
+        std::fprintf(stderr, "run=%d frames_total=%u frames_visible=%u audio_frames=%u first_hash=%llu last_hash=%llu\n",
+                     run + 1, total_frames.load(), visible_frames.load(), audio_frames.load(),
+                     static_cast<unsigned long long>(first_hash.load()),
+                     static_cast<unsigned long long>(last_hash.load()));
+        if (visible_frames.load() < 2) result = 4;
+        else if (first_hash.load() == last_hash.load()) result = 5;
+        else if (audio_frames.load() == 0) result = 6;
+        if (result != 0) break;
+    }
+    std::fprintf(stderr, "probe_result=%d\n", result);
+    // The standalone shadPS4 process uses a process boundary because its
+    // Vulkan/HLE singletons are intentionally process-lifetime objects. The
+    // Libretro lifecycle itself was already exercised by retro_unload_game
+    // and retro_deinit above. TerminateProcess avoids DLL_PROCESS_DETACH
+    // re-entering upstream singleton destructors after the embedded owner has
+    // already shut down; this is only the probe process boundary.
+#ifdef _WIN32
+    TerminateProcess(GetCurrentProcess(), static_cast<UINT>(result));
+#else
+    std::_Exit(result);
+#endif
+}
