+void Emulator::ApplyEmbeddedInput(const std::uint32_t port,
+                                  const CatuiRuntime::InputState& state) {
+    if (!controllers || port >= 5) {
+        return;
+    }
+
+    auto* controller = (*controllers)[port];
+    if (!controller->ReadState().connected) {
+        controller->ConnectController(nullptr);
+    }
+
+    using Button = Libraries::Pad::OrbisPadButtonDataOffset;
+    static constexpr std::array<std::pair<unsigned, Button>, 14> button_map{{
+        {0, Button::Cross},    {1, Button::Square}, {2, Button::TouchPad},
+        {3, Button::Options},  {4, Button::Up},     {5, Button::Down},
+        {6, Button::Left},     {7, Button::Right},  {8, Button::Circle},
+        {9, Button::Triangle}, {10, Button::L1},    {11, Button::R1},
+        {14, Button::L3},      {15, Button::R3},
+    }};
+    for (const auto& [index, button] : button_map) {
+        controller->Button(button, state.buttons[index] != 0);
+    }
+
+    const auto stick = [](const std::int16_t value) {
+        return static_cast<int>((static_cast<std::int32_t>(value) + 32768) * 255 / 65535);
+    };
+    controller->Axis(Input::Axis::LeftX, stick(state.axes[0]), false);
+    controller->Axis(Input::Axis::LeftY, stick(state.axes[1]), false);
+    controller->Axis(Input::Axis::RightX, stick(state.axes[2]), false);
+    controller->Axis(Input::Axis::RightY, stick(state.axes[3]), false);
+    controller->Axis(Input::Axis::TriggerLeft, state.buttons[12] ? 255 : 0, false);
+    controller->Axis(Input::Axis::TriggerRight, state.buttons[13] ? 255 : 0, false);
+    controller->UpdateGyro(state.gyro);
+
+    const auto touch = [](const std::int16_t value) {
+        return static_cast<float>(static_cast<std::int32_t>(value) + 32768) / 65535.0f;
+    };
+    controller->SetTouchpadState(0, state.touch_pressed, touch(state.touch_x),
+                                 touch(state.touch_y));
+}
