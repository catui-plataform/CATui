diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9797d88e..a0949263 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,11 @@ option(ENABLE_DISCORD_RPC "Enable the Discord RPC integration" ON)
 option(ENABLE_UPDATER "Enables the options to updater" ON)
 option(ENABLE_TESTS "Build unit tests (requires GTest)" OFF)
 option(ENABLE_SYSTEM_LIBRARIES "Enable building against system libraries" OFF)
+option(ENABLE_CATUI_LIBRETRO "Build the isolated CATUI Libretro boundary" OFF)
+
+if(ENABLE_CATUI_LIBRETRO)
+    add_subdirectory(src/libretro)
+endif()
 
 # First, determine whether to use CMAKE_OSX_ARCHITECTURES or CMAKE_SYSTEM_PROCESSOR.
 if (APPLE AND CMAKE_OSX_ARCHITECTURES)
@@ -1417,6 +1422,8 @@ if (WIN32)
 
     if (MSVC)
         target_link_libraries(shadps4 PRIVATE clang_rt.builtins-x86_64.lib)
+        # Large translation units in the emulator exceed MSVC's default section limit.
+        target_compile_options(shadps4 PRIVATE /bigobj)
     endif()
 
     # Disable ASLR so we can reserve the user area
@@ -1441,7 +1448,7 @@ if (WIN32)
     endif()
 endif()
 
-if (WIN32)
+if (WIN32 AND NOT (CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC"))
     target_sources(shadps4 PRIVATE src/dist/shadps4.rc)
 endif()
 
@@ -1495,6 +1502,68 @@ if (ENABLE_DISCORD_RPC)
     target_link_libraries(shadps4 PRIVATE discord-rpc)
 endif()
 
+if (ENABLE_CATUI_LIBRETRO)
+    target_sources(shadps4_libretro PRIVATE
+        ${AUDIO_CORE}
+        ${IMGUI}
+        ${INPUT}
+        ${COMMON}
+        ${CORE}
+        ${SHADER_RECOMPILER}
+        ${VIDEO_CORE}
+        ${EMULATOR}
+        ${SHADNET}
+        src/emulator.cpp
+        src/emulator.h
+        src/sdl_window.h
+        src/sdl_window.cpp
+    )
+    target_link_libraries(shadps4_libretro PRIVATE
+        spdlog::spdlog magic_enum::magic_enum fmt::fmt toml11::toml11 tsl::robin_map
+        xbyak::xbyak Tracy::TracyClient RenderDoc::API FFmpeg::ffmpeg Dear_ImGui
+        ImGuiFileDialog gcn half::half ZLIB::ZLIB PNG::PNG minimp3 Boost::headers
+        GPUOpen::VulkanMemoryAllocator LibAtrac9 sirit Vulkan::Headers xxHash::xxhash
+        Zydis::Zydis glslang::glslang SDL3::SDL3 pugixml::pugixml stb::headers
+        lfreist-hwinfo::hwinfo nlohmann_json::nlohmann_json miniz::miniz fdk-aac
+        CLI11::CLI11 OpenAL::OpenAL Cpp_Httplib miniupnpc::miniupnpc Freetype::Freetype
+        libprotobuf ZArchive::zarchive zstd::libzstd res::embedded
+    )
+    target_include_directories(shadps4_libretro PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}
+        ${SHADNET_PROTO_OUT}
+        ${HOST_SHADERS_INCLUDE}
+        ${IMGUI_RESOURCES_INCLUDE}
+    )
+    target_compile_definitions(shadps4_libretro PRIVATE
+        IMGUI_USER_CONFIG="imgui/imgui_config.h" NOMINMAX WIN32_LEAN_AND_MEAN
+        NTDDI_VERSION=0x0A000006 _WIN32_WINNT=0x0A00 WINVER=0x0A00 _TIMESPEC_DEFINED
+    )
+    add_dependencies(shadps4_libretro host_shaders ImGui_Resources)
+
+    if (${CMAKE_SYSTEM_NAME} STREQUAL "FreeBSD")
+        target_link_libraries(shadps4_libretro PRIVATE /usr/lib/libusb.so /usr/local/lib/libuuid.so
+                                                    date::date-tz epoll-shim)
+    else()
+        target_link_libraries(shadps4_libretro PRIVATE libusb::usb)
+    endif()
+    if (${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+        target_link_libraries(shadps4_libretro PRIVATE uuid)
+    endif()
+    if (APPLE)
+        target_link_libraries(shadps4_libretro PRIVATE date::date-tz epoll-shim)
+    endif()
+    if (WIN32)
+        target_link_libraries(shadps4_libretro PRIVATE mincore wepoll wbemuuid)
+        if (MSVC)
+            target_link_libraries(shadps4_libretro PRIVATE clang_rt.builtins-x86_64.lib)
+            target_compile_options(shadps4_libretro PRIVATE /bigobj /clang:-msse4.1)
+        endif()
+    endif()
+    if (NOT MSVC)
+        target_compile_options(shadps4_libretro PRIVATE -Wno-invalid-offsetof)
+    endif()
+endif()
+
 # Install rules
 install(TARGETS shadps4 BUNDLE DESTINATION .)
 
