index 0000000..728ac3f
--- /dev/null
+++ b/libretro/libretro-common/streams/trans_stream_deflate.c
@@ -0,0 +1,279 @@
+/* Copyright  (C) 2010-2024 The RetroArch team
+ *
+ * ---------------------------------------------------------------------------------------
+ * The following license statement only applies to this file (trans_stream_deflate.c).
+ * ---------------------------------------------------------------------------------------
+ *
