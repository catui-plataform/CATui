+
+static INLINE uint32_t rflac__le2host_32_ptr_unaligned(const void* pData)
+{
+   const uint8_t* pNum = (uint8_t*)pData;
+   return  (uint32_t)pNum[0]        | ((uint32_t)pNum[1] <<  8)
+        | ((uint32_t)pNum[2] << 16) | ((uint32_t)pNum[3] << 24);
+}
