+struct USBEndpoint* usb_ep_get(USBDevice* dev, int pid, int ep);
+uint8_t usb_ep_get_type(USBDevice* dev, int pid, int ep);
+void usb_ep_set_type(USBDevice* dev, int pid, int ep, uint8_t type);
