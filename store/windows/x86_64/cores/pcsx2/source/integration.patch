+static INLINE uint32_t rflac__be2host_32_ptr_unaligned(const void* pData)
+{
+   const uint8_t* pNum = (uint8_t*)pData;
+   return ((uint32_t)pNum[0] << 24) | ((uint32_t)pNum[1] << 16)
