+	static QKeyCode retrok_to_qcode(unsigned k)
+	{
+		size_t i;
+		for (i = 0; i < sizeof(s_retrok_to_qcode) / sizeof(s_retrok_to_qcode[0]); i++)
+		{
+			if (s_retrok_to_qcode[i].first == k)
+				return s_retrok_to_qcode[i].second;
+		}
+		return Q_KEY_CODE_UNMAPPED;
+	}
