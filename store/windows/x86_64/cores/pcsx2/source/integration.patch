+/* fixed Huffman code lengths (RFC 1951 3.2.6) */
+static void rd_fixed_lit_lengths(uint8_t *ll)
+{
+   int i;
+   for (i = 0;   i < 144; i++)
+      ll[i] = 8;
+   for (i = 144; i < 256; i++)
+      ll[i] = 9;
+   for (i = 256; i < 280; i++)
+      ll[i] = 7;
+   for (i = 280; i < 288; i++)
+      ll[i] = 8;
+}
