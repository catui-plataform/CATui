+bool ParseTitleId(const char* text, u64& value) {
+    if (!text || text[0] == '\0') {
+        return false;
+    }
+    const auto end = text + std::strlen(text);
+    const auto parsed = std::from_chars(text, end, value, 16);
+    return parsed.ec == std::errc{} && parsed.ptr == end && value != 0;
+}
