+#include <algorithm>
 #include <atomic>
 #include <chrono>
+#include <functional>
+#include <mutex>
 
 namespace VideoCore {
 class ShaderNotify {
 public:
     [[nodiscard]] int ShadersBuilding() noexcept;
+    [[nodiscard]] int ShadersInFlight() const noexcept {
+        return num_in_flight.load(std::memory_order_relaxed);
+    }
+	[[nodiscard]] int ShadersStarted() const noexcept {
+		return num_building.load(std::memory_order_relaxed);
+	}
+
+    void SetShaderBuildingCallback(std::function<void(int, int)> callback);
 
     void MarkShaderComplete() noexcept {
         ++num_complete;
+        std::scoped_lock activity_lock{activity_mutex};
+        const int building = --num_in_flight;
+        std::function<void(int, int)> callback;
+        {
+            std::scoped_lock lock{callback_mutex};
+            callback = shader_building_callback;
+        }
+        if (callback) {
+            // Runtime frontends need the number of pipelines that are still
+            // outstanding, not the historical size of ShaderNotify's batch.
+            callback(std::max(0, building), num_building.load(std::memory_order_relaxed));
+        }
     }
 
     void MarkShaderBuilding() noexcept {
         ++num_building;
+        std::scoped_lock activity_lock{activity_mutex};
+        const int building = ++num_in_flight;
+        std::function<void(int, int)> callback;
+        {
+            std::scoped_lock lock{callback_mutex};
+            callback = shader_building_callback;
+        }
+        if (callback) {
+            callback(building, num_building.load(std::memory_order_relaxed));
+        }
     }
 
 private:
     std::atomic_int num_building{};
     std::atomic_int num_complete{};
+    std::atomic_int num_in_flight{};
     int report_base{};
 
     bool completed{};
     int num_when_completed{};
     std::chrono::steady_clock::time_point complete_time;
+    // Pipeline builds may finish on several renderer workers. Keep live-count
+    // callbacks in the same order as their increments/decrements so a late
+    // positive event can never follow the final zero event.
+    std::mutex activity_mutex;
+    std::mutex callback_mutex;
+    std::function<void(int, int)> shader_building_callback;
 };
