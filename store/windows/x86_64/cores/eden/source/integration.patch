 };
 
+struct PackageInfo {
+    bool valid{};
+    u64 title_id{};
+    u64 base_title_id{};
+    u32 version{};
+    FileSys::TitleType type{};
+};
+
+inline PackageInfo InspectNSP(FileSys::VfsFilesystem& vfs, const std::string& filename) {
+    const auto file = vfs.OpenFile(filename, FileSys::OpenMode::Read);
+    if (!file || !boost::to_lower_copy(file->GetName()).ends_with("nsp")) {
+        return {};
+    }
+    const FileSys::NSP nsp(file);
+    if (nsp.IsExtractedType() || nsp.GetStatus() != Loader::ResultStatus::Success) {
+        return {};
+    }
+    const auto ncas = nsp.GetNCAsCollapsed();
+    const auto meta = std::find_if(ncas.begin(), ncas.end(), [](const auto& nca) {
+        return nca->GetType() == FileSys::NCAContentType::Meta;
+    });
+    if (meta == ncas.end() || (*meta)->GetSubdirectories().empty() ||
+        (*meta)->GetSubdirectories()[0]->GetFiles().empty()) {
+        return {};
+    }
+    const FileSys::CNMT cnmt((*meta)->GetSubdirectories()[0]->GetFiles()[0]);
+    return {
+        .valid = true,
+        .title_id = cnmt.GetTitleID(),
+        .base_title_id = FileSys::GetBaseTitleID(cnmt.GetTitleID()),
+        .version = cnmt.GetTitleVersion(),
+        .type = cnmt.GetType(),
+    };
+}
